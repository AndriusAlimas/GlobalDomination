[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/

# Unity local caches / incremental (sometimes appear outside Library on certain versions or tools)
[Aa]rtifacts/
[Ss]erialized[Bb]uild[Ii]nfo/

# IL2CPP / player build side folders (if you export builds next to the project)
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Recordings, crashes, coverage (large or machine-local)
[Rr]ecordings/
[Cc]rash[Rr]eports/
[Cc]ode[Cc]overage/

# Plastic SCM
.plastic/

# Gradle (Android tooling; if used beside the project)
.gradle/

# Auto-generated solution and project files
ExportedObj/
.consulo/
